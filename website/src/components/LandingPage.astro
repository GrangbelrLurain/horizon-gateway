---
import type { Lang } from "../i18n/ui";
import { ui } from "../i18n/ui";
import Layout from "../layouts/Layout.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t = (key: keyof (typeof ui)["ko"] | keyof (typeof ui)["en"]) => {
  // @ts-expect-error
  return ui[lang][key] ?? ui["ko"][key];
};

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout lang={lang}>
  <main data-lang={lang}>
    <!-- Background Glows — stronger, multi-layer -->
    <div class="glow-hero-primary"></div>
    <div class="glow-hero-secondary"></div>
    <div class="glow-hero-accent"></div>
    <div class="glow-backdrop" style="top: 1400px; left: -200px;"></div>
    <div class="glow-backdrop" style="top: 2600px; right: -200px; background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);"></div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Hero Section — Full-screen centered, big logo               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="hero-section">
      <!-- Animated Logo — big, edge-to-edge feel -->
      <div class="hero-visual">
        <img
          src={`${baseUrl}/logo-animated.svg`}
          alt="Horizon Gateway Logo"
          class="hero-animated-logo"
          loading="eager"
        />
      </div>

      <div class="hero-content">
        <div class="badge">{t('hero.badge')}</div>

        <h1 class="hero-title">
          {t('hero.title.pre')}<br/>
          {t('hero.title.post')}<img src={`${baseUrl}/logo-text.svg`} alt="Horizon Gateway" class="hero-logo-text" />
        </h1>

        <p class="hero-subtitle">
          {t('hero.subtitle')}
        </p>

        <div class="hero-actions">
          <a href="https://github.com/GrangbelrLurain/horizon-gateway/releases" class="btn btn-primary btn-hero-download" id="primary-download-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <div class="btn-text-wrapper">
              <span id="primary-download-text">{t('hero.download.win')}</span>
              <span id="primary-download-subtext" class="btn-subtext">{t('hero.download.sub.win')}</span>
            </div>
          </a>

          <div class="cli-copy-box">
            <span class="cli-prefix">$</span>
            <code class="cli-code">hgc init --project</code>
            <button class="cli-copy-btn" id="copy-cli-btn" aria-label="Copy command">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="copy-icon">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="check-icon" style="display: none; stroke: var(--color-success);">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Features Section                                            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="features-section container" style="margin-top: 140px;">
      <div style="text-align: center; max-width: 620px; margin: 0 auto 50px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{t('features.title')}<span class="text-gradient">{t('features.title.accent')}</span></h2>
        <p style="color: var(--color-text-secondary);">{t('features.subtitle')}</p>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
          </div>
          <h3>{t('features.domain.title')}</h3>
          <p>{t('features.domain.desc')}</p>
          <div class="feature-visual">
            <div class="ping-signal">
              <span class="ring animate-ping"></span>
              <span class="signal-core"></span>
            </div>
            <span style="font-size: 0.85rem; font-family: var(--font-mono); color: var(--color-success)">status: 200 OK (14ms)</span>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3>{t('features.proxy.title')}</h3>
          <p>{t('features.proxy.desc')}</p>
          <div class="feature-visual" style="flex-direction: column; align-items: stretch; gap: 8px;">
            <div class="route-map">
              <span class="route-node">prod-api.com</span>
              <span class="route-arrow">➔</span>
              <span class="route-node highlight">localhost:8080</span>
            </div>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-rose">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/><line x1="8" y1="9" x2="10" y2="9"/></svg>
          </div>
          <h3>{t('features.api.title')}</h3>
          <p>{t('features.api.desc')}</p>
          <div class="feature-visual font-mono" style="font-size: 0.8rem; background: rgba(0,0,0,0.35); border-radius: 8px; padding: 6px 12px; justify-content: flex-start; color: var(--color-accent);">
            <span>{'{ "mocked": true, "status": "success" }'}</span>
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="feature-card glass-panel">
          <div class="feature-icon icon-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <h3>{t('features.mobile.title')}</h3>
          <p>{t('features.mobile.desc')}</p>
          <div class="feature-visual" style="gap: 15px;">
            <span style="font-size: 0.8rem; border: 1px solid var(--border-color); padding: 4px 8px; border-radius: 6px;">{t('features.mobile.connect')}</span>
            <span class="route-arrow">↔</span>
            <span style="font-size: 0.8rem; border: 1px solid var(--color-success); padding: 4px 8px; border-radius: 6px; color: var(--color-success)">{t('features.mobile.tunnel')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Feature Gallery Section — 4-tab interactive mockup          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="gallery-section container" style="margin-top: 160px;">
      <div style="text-align: center; max-width: 620px; margin: 0 auto 50px;">
        <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{t('gallery.title')}<span class="text-gradient">{t('gallery.title.accent')}</span></h2>
        <p style="color: var(--color-text-secondary);">{t('gallery.subtitle')}</p>
      </div>

      <!-- Gallery Tabs -->
      <div class="gallery-tabs">
        <button class="gallery-tab active" data-tab="domains">{t('gallery.tab.domains')}</button>
        <button class="gallery-tab" data-tab="proxy">{t('gallery.tab.proxy')}</button>
        <button class="gallery-tab" data-tab="mocking">{t('gallery.tab.mocking')}</button>
        <button class="gallery-tab" data-tab="inspector">{t('gallery.tab.inspector')}</button>
      </div>

      <!-- Gallery Panels -->
      <div class="gallery-panel-wrap">

        <!-- Panel: Domains -->
        <div class="gallery-panel active glass-panel" data-panel="domains">
          <div class="mockup-header">
            <div class="mockup-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
            <div class="mockup-address">{t('gallery.domains.label')}</div>
          </div>
          <div class="gallery-mockup-body">
            <div class="gallery-sidebar">
              <div class="gallery-sidebar-item active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
                Domains
              </div>
              <div class="gallery-sidebar-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                Local Proxy
              </div>
              <div class="gallery-sidebar-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/></svg>
                APIs & Mocking
              </div>
              <div class="gallery-sidebar-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/></svg>
                Inspector
              </div>
            </div>
            <div class="gallery-main">
              <div class="gallery-main-header">
                <span style="font-size:0.82rem; font-weight:600;">Domain Health Status</span>
                <span class="status-live-badge">● Live</span>
              </div>
              <!-- domain group -->
              <div class="g-group-label">Production</div>
              <div class="g-domain-row ok">
                <span class="g-dot ok"></span>
                <div class="g-domain-info">
                  <span class="g-domain-name">api.production.com</span>
                  <span class="g-domain-meta">200 OK · 12ms</span>
                </div>
                <div class="g-sparkline"><span style="height:40%"></span><span style="height:55%"></span><span style="height:50%"></span><span style="height:70%"></span><span class="ok" style="height:85%"></span></div>
              </div>
              <div class="g-domain-row ok">
                <span class="g-dot ok"></span>
                <div class="g-domain-info">
                  <span class="g-domain-name">auth.service.com</span>
                  <span class="g-domain-meta">200 OK · 8ms</span>
                </div>
                <div class="g-sparkline"><span style="height:30%"></span><span style="height:45%"></span><span style="height:40%"></span><span style="height:55%"></span><span class="ok" style="height:65%"></span></div>
              </div>
              <div class="g-group-label" style="margin-top:10px;">Staging</div>
              <div class="g-domain-row warn">
                <span class="g-dot warn"></span>
                <div class="g-domain-info">
                  <span class="g-domain-name">legacy-db.internal</span>
                  <span class="g-domain-meta">Timeout · HTTP 504</span>
                </div>
                <div class="g-sparkline"><span style="height:70%"></span><span style="height:65%"></span><span style="height:20%"></span><span style="height:5%"></span><span class="warn" style="height:0%"></span></div>
              </div>
              <div class="g-domain-row ok">
                <span class="g-dot ok"></span>
                <div class="g-domain-info">
                  <span class="g-domain-name">cdn.assets.internal</span>
                  <span class="g-domain-meta">200 OK · 4ms</span>
                </div>
                <div class="g-sparkline"><span style="height:60%"></span><span style="height:70%"></span><span style="height:65%"></span><span style="height:80%"></span><span class="ok" style="height:90%"></span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Proxy -->
        <div class="gallery-panel glass-panel" data-panel="proxy">
          <div class="mockup-header">
            <div class="mockup-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
            <div class="mockup-address">{t('gallery.proxy.label')}</div>
          </div>
          <div class="gallery-mockup-body">
            <div class="gallery-sidebar">
              <div class="gallery-sidebar-item">Domains</div>
              <div class="gallery-sidebar-item active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                Local Proxy
              </div>
              <div class="gallery-sidebar-item">APIs & Mocking</div>
              <div class="gallery-sidebar-item">Inspector</div>
            </div>
            <div class="gallery-main">
              <div class="gallery-main-header">
                <span style="font-size:0.82rem; font-weight:600;">Local MITM Proxy</span>
                <span class="status-live-badge proxy-on">● Running :8888</span>
              </div>
              <!-- proxy status row -->
              <div class="g-proxy-info">
                <div class="g-proxy-stat"><span class="g-stat-val">8888</span><span class="g-stat-lbl">HTTP Port</span></div>
                <div class="g-proxy-stat"><span class="g-stat-val">8889</span><span class="g-stat-lbl">HTTPS Port</span></div>
                <div class="g-proxy-stat"><span class="g-stat-val">47</span><span class="g-stat-lbl">Requests/min</span></div>
              </div>
              <!-- route rules -->
              <div class="g-group-label" style="margin-top:14px;">Route Rules</div>
              <div class="g-route-row">
                <div class="g-route-from">api.production.com</div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-secondary)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                <div class="g-route-to">localhost:3001</div>
                <span class="g-route-badge on">ON</span>
              </div>
              <div class="g-route-row">
                <div class="g-route-from">cdn.assets.internal</div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-secondary)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                <div class="g-route-to">./dist/assets/</div>
                <span class="g-route-badge on">ON</span>
              </div>
              <div class="g-route-row">
                <div class="g-route-from">auth.legacy.com</div>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-muted)" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                <div class="g-route-to" style="color: var(--color-text-muted);">localhost:4000</div>
                <span class="g-route-badge off">OFF</span>
              </div>
              <!-- traffic log -->
              <div class="g-group-label" style="margin-top:14px;">Recent Traffic</div>
              <div class="g-log-row"><span class="g-method get">GET</span><span class="g-log-path">/api/users</span><span class="g-log-status ok-s">200</span><span class="g-log-ms">12ms</span></div>
              <div class="g-log-row"><span class="g-method post">POST</span><span class="g-log-path">/api/auth/login</span><span class="g-log-status ok-s">201</span><span class="g-log-ms">34ms</span></div>
              <div class="g-log-row"><span class="g-method get">GET</span><span class="g-log-path">/api/products?page=2</span><span class="g-log-status err-s">504</span><span class="g-log-ms">3000ms</span></div>
            </div>
          </div>
        </div>

        <!-- Panel: Mocking -->
        <div class="gallery-panel glass-panel" data-panel="mocking">
          <div class="mockup-header">
            <div class="mockup-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
            <div class="mockup-address">{t('gallery.mocking.label')}</div>
          </div>
          <div class="gallery-mockup-body">
            <div class="gallery-sidebar">
              <div class="gallery-sidebar-item">Domains</div>
              <div class="gallery-sidebar-item">Local Proxy</div>
              <div class="gallery-sidebar-item active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/></svg>
                APIs & Mocking
              </div>
              <div class="gallery-sidebar-item">Inspector</div>
            </div>
            <div class="gallery-main">
              <div class="gallery-main-header">
                <span style="font-size:0.82rem; font-weight:600;">Mock Rules</span>
                <span class="status-live-badge mock-on">3 Active</span>
              </div>
              <!-- mock rule -->
              <div class="g-mock-rule">
                <div class="g-mock-rule-header">
                  <span class="g-method post">POST</span>
                  <span class="g-mock-path">/api/auth/login</span>
                  <span class="g-mock-toggle active">●</span>
                </div>
                <div class="g-mock-editor">
                  <div class="g-editor-line"><span class="json-key">"status"</span><span>: </span><span class="json-num">200</span><span>,</span></div>
                  <div class="g-editor-line"><span class="json-key">"body"</span><span>: </span><span class="json-str">{"{"}</span></div>
                  <div class="g-editor-line indent"><span class="json-key">"token"</span><span>: </span><span class="json-str">"eyJhbGciOi..."</span><span>,</span></div>
                  <div class="g-editor-line indent"><span class="json-key">"user"</span><span>: </span><span class="json-str">{"{"} "id": 1, "role": "admin" {"}"}</span></div>
                  <div class="g-editor-line"><span class="json-str">{"}"}</span></div>
                </div>
              </div>
              <div class="g-mock-rule" style="opacity:0.6;">
                <div class="g-mock-rule-header">
                  <span class="g-method get">GET</span>
                  <span class="g-mock-path">/api/products</span>
                  <span class="g-mock-toggle">○</span>
                </div>
              </div>
              <div class="g-mock-rule" style="opacity:0.6;">
                <div class="g-mock-rule-header">
                  <span class="g-method get">GET</span>
                  <span class="g-mock-path">/api/users/me</span>
                  <span class="g-mock-toggle active">●</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel: Inspector -->
        <div class="gallery-panel glass-panel" data-panel="inspector">
          <div class="mockup-header">
            <div class="mockup-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
            <div class="mockup-address">{t('gallery.inspector.label')}</div>
          </div>
          <div class="gallery-mockup-body">
            <div class="gallery-sidebar">
              <div class="gallery-sidebar-item">Domains</div>
              <div class="gallery-sidebar-item">Local Proxy</div>
              <div class="gallery-sidebar-item">APIs & Mocking</div>
              <div class="gallery-sidebar-item active">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/></svg>
                Inspector
              </div>
            </div>
            <div class="gallery-main">
              <div class="gallery-main-header">
                <span style="font-size:0.82rem; font-weight:600;">UI Annotations</span>
                <span class="status-live-badge inspector-on">Injecting</span>
              </div>
              <!-- browser preview area -->
              <div class="g-browser-preview">
                <div class="g-page-sim">
                  <div class="g-page-nav"></div>
                  <div class="g-page-hero"></div>
                  <div class="g-page-row">
                    <div class="g-page-card highlighted">
                      <div class="g-annotation-badge">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        Submit Button
                      </div>
                    </div>
                    <div class="g-page-card"></div>
                    <div class="g-page-card"></div>
                  </div>
                </div>
              </div>
              <!-- annotation detail -->
              <div class="g-annotation-detail">
                <div class="g-ann-row"><span class="g-ann-key">Role</span><span class="g-ann-val">Submit Button</span></div>
                <div class="g-ann-row"><span class="g-ann-key">Selector</span><span class="g-ann-val mono">[data-testid="submit"]</span></div>
                <div class="g-ann-row"><span class="g-ann-key">Status</span><span class="g-ann-val ok-text">● Valid</span></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CLI Terminal Section                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="terminal-section container" style="margin-top: 160px;">
      <div style="max-width: 500px;">
        <div class="badge" style="background: rgba(59, 130, 246, 0.1); color: var(--color-secondary); border-color: rgba(59, 130, 246, 0.2);">{t('terminal.badge')}</div>
        <h2 style="font-size: 2.3rem; margin: 15px 0;">{t('terminal.title')}<span class="text-gradient">{t('terminal.title.accent')}</span>{t('terminal.title.post')}</h2>
        <p style="color: var(--color-text-secondary); margin-bottom: 20px;">
          {t('terminal.desc')}
        </p>
        <div class="terminal-buttons">
          <button class="btn btn-secondary terminal-tab active" data-command="init">hgc init</button>
          <button class="btn btn-secondary terminal-tab" data-command="list">hgc list</button>
          <button class="btn btn-secondary terminal-tab" data-command="run">hgc run</button>
        </div>
      </div>

      <div class="terminal-mockup glass-panel">
        <div class="mockup-header" style="background: rgba(0,0,0,0.5)">
          <div class="mockup-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
